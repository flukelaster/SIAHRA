{
  /*
   * เทสของ apps/web ทั้ง `src/**` และ `worker/**` ถูก exclude ออกจาก
   * tsconfig.app.json / tsconfig.worker.json เพราะไม่ควรอยู่ใน build graph
   * ของ Worker (จะลาก types ของ vitest เข้าไป) — ผลข้างเคียงคือ **ไม่มีใคร
   * type-check ไฟล์เทสเลย** โปรเจกต์นี้ปิดรูนั้น เป็นแบบเดียวกับ
   * `apps/api/test/tsconfig.json` ต่างกันที่ถูก reference จาก tsconfig.json
   * จึงถูกตรวจโดย `npx tsc -b` ที่ CI รันอยู่แล้ว ไม่ต้องเพิ่ม job ใหม่
   */
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.test.tsbuildinfo",
    "target": "es2022",
    "lib": ["es2022", "dom", "dom.iterable"],
    "module": "es2022",
    "types": ["vitest/globals", "vite/client", "node"],
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "jsx": "react-jsx",
    "noEmit": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src/**/*.test.ts", "src/**/*.test.tsx", "worker/**/*.test.ts"]
}
