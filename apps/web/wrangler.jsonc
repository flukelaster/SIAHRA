{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "siahra-web",
  "compatibility_date": "2026-08-16",

  // Almost everything here is a static asset; `worker/index.ts` exists only to
  // read the R2 tile pyramid (see the file's header). Deploying this Worker
  // still never touches `siahra-api` (Durable Objects, cron) and vice versa —
  // that split is the whole point of having two configs.
  "main": "worker/index.ts",

  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },

  "r2_buckets": [
    { "binding": "HAZARD_BUCKET", "bucket_name": "siahra-geodata" }
  ],

  // A Custom Domain, not a route: this Worker *is* the site's origin, and a
  // Custom Domain points every path of the hostname here and creates the proxied
  // DNS record itself. (A plain route would need a hand-made proxied record —
  // Cloudflare's docs specifically steer away from the placeholder `AAAA 100::`
  // that implies.)
  //
  // siahra-api then layers on top with the narrower route `siahra-radar.co/api/*`:
  // Workers on routes run *before* the Custom Domain Worker, so /api/* is
  // answered there and never reaches this one, while everything else lands here.
  // One public origin is the point — it keeps the relative `fetch("/api/v1/...")`
  // calls and the `location.host` WebSocket URL in apps/web working unchanged,
  // and lets ALLOWED_ORIGINS stay empty.
  "routes": [
    { "pattern": "siahra-radar.co", "custom_domain": true }
  ],

  // The same-origin guard in apps/api assumes a single public host. A
  // *.workers.dev copy of the SPA would call the API cross-origin and be
  // rejected with 403, so don't publish one.
  "workers_dev": false,

  // Deliberately NO `run_worker_first`. Two observations, and they do NOT
  // agree — keep both, and trust the production one when it matters:
  //
  //  - `wrangler dev` (recorded when this line was written): the SPA fallback
  //    of `not_found_handling: "single-page-application"` only answered
  //    *navigation* requests (wrangler logs `Sec-Fetch-Mode: navigate` when it
  //    applies), so a `fetch()` for a tile missing from the asset bundle fell
  //    through to the Worker.
  //  - **production, measured 2026-08-20 with `curl -I`**: it does NOT behave
  //    that way. `/aoi/11/v/2026-08-17/terrain/0/0_0.bin` (a path the deployed
  //    Worker's `parseTilePath` does not claim) answers `200 text/html` —
  //    index.html — even with `Accept: application/octet-stream`, and so does
  //    any other unclaimed extension-bearing path. It never 404s. Only paths
  //    the Worker *does* claim reach it (`/aoi/11/terrain/0/9999_9999.bin` →
  //    `404 text/plain` from the Worker's own miss branch).
  //
  // The cause of the divergence is NOT established here — only the behaviour
  // is. One untested hypothesis worth checking first if anyone ever digs in:
  // in production the shell may be coming out of this Worker's own
  // `if (!tile) return env.ASSETS.fetch(request)` fallthrough (worker/index.ts)
  // rather than from the asset layer answering ahead of it, in which case
  // `not_found_handling` is what turns that fallthrough into index.html. Both
  // stories fit every measurement above equally well; do not write either one
  // down as fact without a test that separates them.
  //
  // What follows operationally, either way: a path this Worker does not claim
  // gets the SPA shell, not a 404, so **status alone can never prove a tile is
  // reachable** — every tile probe in scripts/{release-dataset,upload-tiles,
  // verify-tiles}.sh requires `application/octet-stream` as well. Anything
  // relying on a tile URL 404ing in production is wrong today.
  //
  // `run_worker_first` stays off regardless: it would put a Worker invocation
  // in front of every tracked static file under /aoi/ (manifest.json,
  // boundary.geojson, hillshade.png, the terrain.bin overview), and measured
  // above, the tile paths the Worker claims reach it as things stand.
  "observability": { "enabled": true }
}
