# apps/api — local secrets for `wrangler dev`. Copy to `.dev.vars` (gitignored)
# and fill in. In production the same keys are set with
#   npx wrangler secret put TMD_UID
#   npx wrangler secret put TMD_UKEY
#   npx wrangler secret put TMD_NWP_TOKEN
#   npx wrangler secret put GISTDA_API_KEY
# (see docs/deploy.md §0 and §3). Without TMD_UID/TMD_UKEY only the TMD seismic feed
# degrades — /api/v1/health reports the earthquakes source as `degraded` with
# lastError "TMD credentials not configured"; USGS, EMSC and every other
# source keep working.

# TMD open-data API credentials — register at https://data.tmd.go.th/
TMD_UID=""
TMD_UKEY=""

# TMD NWP (numerical weather forecast) API bearer token — a separate key from
# TMD_UID/TMD_UKEY above, issued at https://data.tmd.go.th/nwpapi/. The issued
# token is a 365-day JWT; the one in use expires 2027-08-18, after which the
# forecast source reports "TMD NWP token rejected (401)" until it is replaced.
# Without it /api/v1/health reports tmd-nwp as degraded with lastError
# "TMD NWP token not configured"; every other source keeps working.
TMD_NWP_TOKEN=""

# GISTDA API-gateway key (satellite flood extent, E16.PR0) — request one at
# https://api-gateway.gistda.or.th/. Sent only as the `API-Key` request header
# (never as ?api_key=). Without it the flood-extent source makes no upstream call
# and /api/v1/health reports gistda-flood as down with lastError
# "GISTDA_API_KEY not configured — no request sent to GISTDA".
GISTDA_API_KEY=""
